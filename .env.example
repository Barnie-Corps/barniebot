# Copy this file to .env and fill in the values below.
# Variables with no default are required unless noted otherwise.

# ── Discord ──────────────────────────────────────────────────────────────
TOKEN=""                       # Discord bot token
DISCORD_BOT_ID=""              # Discord application (client) ID
OWNERS=""                      # Comma-separated Discord user IDs with owner (b.*) access

# ── Database (MySQL, required) ──────────────────────────────────────────
DB_HOST=""
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
DB_PORT=""

# ── Security ─────────────────────────────────────────────────────────────
ENCRYPTION_KEY=""              # Required. Generate with: openssl rand -base64 32

# ── AI (NVIDIA NIM, required for /ai commands) ──────────────────────────
NVIDIA_API_KEY=""
NVIDIA_STT_FUNCTION_ID=""      # Riva ASR function ID, required for /ai voice
NVIDIA_TTS_FUNCTION_ID=""      # Riva TTS function ID, required for /ai voice
AI_DEBUG=0                     # Set to 1 to log verbose AI/voice debug output

# ── AI (Ollama, optional local fallback) ────────────────────────────────
OLLAMA_ENABLED=false
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5:0.5b
OLLAMA_MODERATION_MODEL=phi3:latest
OLLAMA_VISION_MODEL=llava:latest
OLLAMA_CHAT_FILTER=false

# ── AI Functions (optional) ─────────────────────────────────────────────
SEARCH_ENGINE_API_KEY=""       # Google Custom Search API key
SEARCH_ENGINE_CX=""            # Google Custom Search engine ID
GITHUB_TOKEN=""                # GitHub API token for AI repo-lookup functions
GH_TOKEN=""                    # Fallback if GITHUB_TOKEN is unset

# ── Email (required for RPG account verification) ──────────────────────
EMAIL_PASSWORD=""              # Gmail app-specific password (not your account password)

# ── Cache (optional, falls back to in-memory cache if unset/unreachable) ─
REDIS_URL=""
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# ── Workers ──────────────────────────────────────────────────────────────
TRANSLATE_WORKERS=5            # Translation worker pool size (default: CPU count)

# ── Runtime / misc ───────────────────────────────────────────────────────
NODE_ENV="development"
TEST=0                         # Set to 1 to restrict all commands to owners only
SYSTEM_IP=""                   # If set, redacted from /gethtml output
IGNORE_GLOBAL_CHAT=0           # Set to 1 to skip global chat message processing
NOTIFY_STARTUP=1               # Notify owners on startup after an unclean shutdown
FETCH_MEMBERS_ON_STARTUP=0     # Fetch all guild members on startup

# ── Managed by the bot/ProcessManager at runtime — do not set manually ──
SAFELY_SHUTTED_DOWN=0
REBOOTING=0
MEMBERS_FETCHED=0
